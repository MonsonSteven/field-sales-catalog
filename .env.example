# Copy to .env and fill in. .env is gitignored (never committed).

# Neon Postgres connection string (use the POOLED string from the Neon dashboard).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URI=

# Schema auto-push. Set to "true" for the FIRST run against a fresh Neon DB so Payload
# creates the tables; leave blank afterward.
PAYLOAD_DB_PUSH=

# Payload secret — random string used to sign/encrypt sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Comma-separated emails that get the ADMIN role in the Payload admin (create/delete
# products, edit synced fields). Everyone else who can log in is an "editor".
ADMIN_EMAILS=admin@summithome.example

# Portfolio demo: open access. "true" removes the storefront login wall so anyone can
# browse (the auth code stays intact and is used when this is off). Set it in the demo
# deployment; leave blank to exercise the real rep-login flow.
DEMO_OPEN_ACCESS=true

# --- Transactional email (OPTIONAL) ---
# Only needed in production for admin password-reset / invite emails. Leave SMTP_HOST
# blank in dev — Payload logs emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@summithome.example
EMAIL_FROM_NAME=Summit Catalog
